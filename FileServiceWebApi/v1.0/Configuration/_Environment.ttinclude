<#@ import namespace="System" #>
<#
    var configs = new Config[]{
		new Config
        {
            Environment = Environment.DEV
        },
        new Config
        {
            Environment = Environment.LOCAL
        },
		new Config
        {
            Environment = Environment.MASTER
        },
        new Config
        {
            Environment = Environment.SIT
        },
        new Config
        {
