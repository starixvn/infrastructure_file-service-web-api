#>
<#+ 
	enum Environment
    {
		DEV,
        LOCAL,
		MASTER,
        SIT,
        UAT,
        MNL,
        PRO
    }

	class Config
	{
		public Environment Environment { get; set; }

		#region Appsetting

		public string ServerInfoUserName
		{
			get
			{
				switch(Environment)
                {
					case Environment.DEV:
					case Environment.LOCAL:
					case Environment.MASTER:
						return "";

					case Environment.SIT:
						return "sitUserName";

					case Environment.MNL:
                        return "mnlUserName";

					case Environment.UAT:
                    case Environment.PRO:
                        return "prodUserName";

                    

                    

                    default:
                        return string.Empty;
                }
			}
		}

		public string ServerInfoPassword
		{
			get
			{
				switch(Environment)
                {
					case Environment.DEV:
					case Environment.LOCAL:
					case Environment.MASTER:
						return "";

					case Environment.SIT:
						return "sitPassword";

					case Environment.MNL:
                        return "mnlPassword";

					case Environment.UAT:
                    case Environment.PRO:
                        return "prodPassword";

                    

                    

                    default:
                        return string.Empty;
                }
			}
		}

		public string ServerInfoPath
		{
			get
			{
				switch(Environment)
                {
					case Environment.DEV:
					case Environment.LOCAL:
					case Environment.MASTER:
						return "\\\\CP008-ALAN\\network";

					case Environment.SIT:
						return "sitPath";

					case Environment.MNL:
                        return "mnlPath";

					case Environment.UAT:
                    case Environment.PRO:
                        return "prodPath";

                    

                    

                    default:
                        return string.Empty;
                }
			}
		}

		#endregion Appsetting
	}
 #>